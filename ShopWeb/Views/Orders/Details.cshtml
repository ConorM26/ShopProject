
@model ShopWeb.Models.Shop.PostDetailsViewModel
@using System.Security.Claims

@{
    ViewData["Title"] = "Post Details";
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<h1>@Model.Post.Title</h1>

<p>@Model.Post.Content</p>

<p class="text-muted">
    Posted on @Model.Post.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
</p>

<a asp-controller="Posts" asp-action="Index"
   class="btn btn-secondary mb-4">
    Back to Posts
</a>

<hr />

<h3>Comments</h3>

@if (!Model.Comments.Any())
{
    <p>No comments yet.</p>
}
else
{
    @foreach (var comment in Model.Comments)
    {
        <div class="card mb-3">
            <div class="card-body">
                <p>@comment.Content</p>

                <small class="text-muted">
                    @comment.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                </small>

                @if (User.Identity?.IsAuthenticated == true &&
                     comment.UserId == userId)
                {
                    <div class="mt-3">
                        <a asp-controller="Comments"
                           asp-action="Edit"
                           asp-route-id="@comment.Id"
                           asp-route-postId="@Model.Post.Id"
                           class="btn btn-sm btn-outline-primary">
                            Edit
                        </a>

                        <form asp-controller="Comments"
                              asp-action="Delete"
                              asp-route-id="@comment.Id"
                              method="post"
                              class="d-inline">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="postId"
                                   value="@Model.Post.Id" />

                            <button type="submit"
                                    class="btn btn-sm btn-outline-danger"
                                    onclick="return confirm('Delete this comment?');">
                                Delete
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
    }
}

@if (User.Identity?.IsAuthenticated == true)
{
    <h4 class="mt-4">Add a Comment</h4>

    <form asp-controller="Comments"
          asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               asp-for="NewComment.PostId"
               name="PostId" />

        <div class="mb-3">
            <label for="Content" class="form-label">
                Comment
            </label>

            <textarea name="Content"
                      id="Content"
                      class="form-control"
                      rows="3"
                      maxlength="500"
                      required></textarea>
        </div>

        <button type="submit" class="btn btn-primary">
            Post Comment
        </button>
    </form>
}
else
{
    <p>
        <a asp-area="Identity" asp-page="/Account/Login">
            Log in
        </a>
        to leave a comment.
    </p>
}
