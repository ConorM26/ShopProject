
@model ShopWeb.Models.Shop.CreateOrderViewModel
@using System.Globalization

@{
    ViewData["Title"] = "New order";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a asp-action="Index">My orders</a>
        </li>
        <li class="breadcrumb-item active">New order</li>
    </ol>
</nav>

<h1>New order</h1>

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="All" class="alert alert-danger"></div>
}

@if (!Model.Lines.Any())
{
    <p>There are no items to order yet.</p>
}
else
{
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <table class="table">
            <thead>
                <tr>
                    <th>Item</th>
                    <th>Price</th>
                    <th>In stock</th>
                    <th>Quantity</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.Lines.Count; i++)
                {
                    var line = Model.Lines[i];

                    <tr>
                        <td>
                            @line.Name
                            <input type="hidden"
                                   asp-for="Lines[i].ItemId" />
                        </td>
                        <td>@line.Price.ToString("C")</td>
                        <td>@line.StockQuantity</td>
                        <td>
                            <input asp-for="Lines[i].Quantity"
                                   type="number"
                                   min="0"
                                   max="1000"
                                   class="form-control quantity-input"
                                   data-price="@line.Price.ToString(CultureInfo.InvariantCulture)" />
                            <span asp-validation-for="Lines[i].Quantity"
                                  class="text-danger"></span>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th>Estimated total</th>
                    <th id="estimated-total">
                        @Model.EstimatedTotal.ToString("C")
                    </th>
                    <th></th>
                    <th></th>
                </tr>
            </tfoot>
        </table>

        <p class="text-muted">
            Prices and stock are confirmed by the shop when you place the order.
        </p>

        <button type="submit" class="btn btn-primary">
            Place order
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const quantityInputs = document.querySelectorAll(".quantity-input");
        const totalElement = document.getElementById("estimated-total");

        function updateTotal() {
            let total = 0;

            quantityInputs.forEach(input => {
                const price = Number(input.dataset.price);
                const quantity = Number(input.value) || 0;

                total += price * quantity;
            });

            if (totalElement) {
                totalElement.textContent = new Intl.NumberFormat("en-IE", {
                    style: "currency",
                    currency: "EUR"
                }).format(total);
            }
        }

        quantityInputs.forEach(input => {
            input.addEventListener("input", updateTotal);
        });
    </script>
}
