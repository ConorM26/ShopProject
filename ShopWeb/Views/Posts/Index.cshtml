
@model IReadOnlyList<ShopWeb.Models.Shop.PostDto>
@using System.Security.Claims

@{
    ViewData["Title"] = "Posts";
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<h1>Posts</h1>

<p>View posts shared by users.</p>

@if (User.Identity?.IsAuthenticated == true)
{
    <a asp-controller="Posts"
       asp-action="Create"
       class="btn btn-primary mb-3">
        Create Post
    </a>
}

@if (!Model.Any())
{
    <p>No posts have been created yet.</p>
}
else
{
    @foreach (var post in Model)
    {
        <div class="card mb-3">
            <div class="card-body">

                <h4>@post.Title</h4>

                <p>@post.Content</p>

                <small class="text-muted">
                    @post.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                </small>

                @if (User.Identity?.IsAuthenticated == true
                    && post.UserId == userId)
                {
                    <div class="mt-3">

                        <a asp-controller="Posts"
                           asp-action="Edit"
                           asp-route-id="@post.Id"
                           class="btn btn-sm btn-outline-primary">
                            Edit
                        </a>

                        <form asp-controller="Posts"
                              asp-action="Delete"
                              asp-route-id="@post.Id"
                              method="post"
                              class="d-inline">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-sm btn-outline-danger"
                                    onclick="return confirm('Delete this post?');">
                                Delete
                            </button>

                        </form>
                    </div>
                }

            </div>
        </div>
    }
}
