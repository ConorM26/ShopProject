
@model ShopWeb.Models.Shop.CommentDto

@{
    ViewData["Title"] = "Edit Comment";
}

<h1>Edit Comment</h1>

<p>Update your comment below.</p>

<form method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" name="postId" value="@ViewBag.PostId" />

    <div class="mb-3">
        <label for="content" class="form-label">Comment</label>

        <textarea name="content"
                  id="content"
                  class="form-control"
                  rows="4"
                  maxlength="500"
                  required>@Model.Content</textarea>
    </div>

    <button type="submit" class="btn btn-primary">
        Save Changes
    </button>

    <a asp-controller="Posts"
       asp-action="Details"
       asp-route-id="@ViewBag.PostId"
       class="btn btn-secondary">
        Cancel
    </a>
</form>
