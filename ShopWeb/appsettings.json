

{
  "ConnectionStrings": {
    "DefaultConnection": "DataSource=app.db;Cache=Shared"
  },
  "ShopApi": {
    "BaseUrl": "https://localhost:7001/"
  },
  "Jwt": {
    "Issuer": "ShopWeb",
    "Audience": "ShopApi",
    "TokenLifetimeMinutes": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
